# Base URL of the QA deployment
GRACIE_BASE_URL=http://localhost:8080

# Login email of the QA staff user
STAFF_EMAIL=staff@example.test
# Password of the QA staff user
STAFF_PASSWORD=<staff-password>

MANAGER_TOKEN=<manager-api-token>  # API token of the QA manager
ADMIN_TOKEN=<admin-api-token>  # API token of the QA admin

# Id of the seeded QA property used by the oracles
SMART_LOG_TENANT_ID=<qa-property-id>

# Read-only connection to the Smart Log database
TRUTH_DB_DSN=<read-only-postgres-dsn>
# Write connection used by the seed reset script
SEED_DB_DSN=<write-postgres-dsn>
