TESSA_ENV=prod
TESSA_LOG_LEVEL=info
TESSA_TEMPORAL_ADDRESS=temporal-frontend.temporal.svc.cluster.local:7233
TESSA_TEMPORAL_NAMESPACE=default
TESSA_TEMPORAL_TASK_QUEUE=tessa
TESSA_TEMPORAL_UI_URL=https://temporal.example.com
TESSA_PUBLIC_API_URL=https://tessa-api.example.com
TESSA_CORS_ORIGINS=https://tessa.example.com
TESSA_DOCS_ENABLED=false
TESSA_API_JWT_ISSUER=tessa-web
TESSA_API_JWT_AUDIENCE=tessa-api
TESSA_WS_TICKET_TTL_SECONDS=30
TESSA_STREAM_HEARTBEAT_SECONDS=15
TESSA_STREAM_MAX_AGE_SECONDS=900
TESSA_STREAM_REPLAY_MAX_EVENTS=5000
TESSA_WS_MAX_CONNECTIONS_PER_USER=20
TESSA_WS_SEND_QUEUE_MAX=5000
TESSA_LIVE_MAX_TILES_PER_CLIENT=12
TESSA_LIVE_GRID_MAX_FPS=4
TESSA_LIVE_GRID_QUALITY=60
TESSA_LIVE_GRID_MAX_WIDTH=640
TESSA_LIVE_FOCUS_MAX_FPS=10
TESSA_LIVE_FOCUS_QUALITY=75
TESSA_LIVE_FOCUS_MAX_WIDTH=1280
TESSA_SCHEMAS_DIR=/app/schemas
TESSA_BOOTSTRAP_ADMIN_EMAIL=admin@tessa.local
TESSA_IDEMPOTENCY_TTL_HOURS=24
TESSA_LAYA_URL=http://tessa-laya:7006
TESSA_DATA_DIR=/data
TESSA_BUNDLE_MAX_ZIP_BYTES=26214400
TESSA_BUNDLE_MAX_UNCOMPRESSED_BYTES=104857600
TESSA_BUNDLE_MAX_FILES=2000
TESSA_BUNDLE_MAX_FILE_BYTES=10485760
TESSA_BUNDLE_MAX_MANIFEST_BYTES=1048576
TESSA_BUNDLE_COMPLETENESS_BAR=80
TESSA_HEALTH_CHECK_TIMEOUT_SECONDS=10
TESSA_HEALTH_CHECK_CONCURRENCY=8
TESSA_MEDIA_URL_TTL_SECONDS=900
TESSA_PLAN_MAX_K=10
TESSA_RUN_DEFAULT_MAX_USD=5
TESSA_RUN_DEFAULT_MAX_MINUTES=30
TESSA_PRODUCTION_URL_PATTERNS=^https://[^/]+\.example\.com
TESSA_RUN_MAX_CONCURRENCY=4
TESSA_ARTIFACT_RETENTION_DAYS=30
TESSA_ORACLE_MAX_ROWS=200
TESSA_PROBES_DIR=/app/probes
TESSA_PROBE_CONFIDENCE_THRESHOLD=0.75
TESSA_JUDGE_ESCALATE_BELOW=0.6
TESSA_LABEL_AUDIT_RATE=0.05
TESSA_STUB_MODELS=false
TESSA_MODEL_JUDGE=gpt-6.1-sol
TESSA_EFFORT_JUDGE=low
TESSA_MAX_USD_JUDGE=0.05
TESSA_MAX_OUTPUT_TOKENS_JUDGE=800
TESSA_TIMEOUT_SECONDS_JUDGE=60
TESSA_MODEL_JUDGE_TIEBREAK=claude-sonnet-5-5
TESSA_EFFORT_JUDGE_TIEBREAK=low
TESSA_MAX_USD_JUDGE_TIEBREAK=0.05
TESSA_MAX_OUTPUT_TOKENS_JUDGE_TIEBREAK=800
TESSA_TIMEOUT_SECONDS_JUDGE_TIEBREAK=60
TESSA_EMBEDDING_MODEL=text-embedding-3-small
TESSA_EMBEDDING_DIMENSIONS=1536
TESSA_METRICS_ENABLED=false
TESSA_EXPLAIN_MAX_CHARS=24000
TESSA_EXPLANATION_MAX_CHARS=20000
TESSA_PLAN_ESTIMATE_COST_PER_CELL_USD=0.10
TESSA_REPORT_BASE_URL=https://tessa.example.com
TESSA_FLAKY_QUARANTINE_AFTER=3
TESSA_COMMIT_TIER_MAX_MINUTES=10
TESSA_CALIBRATION_MIN_LABELS=30
TESSA_RETENTION_STEPS_DAYS=90
